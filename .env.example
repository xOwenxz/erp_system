# Copie para .env e ajuste conforme necessário.

# Banco de dados (padrão: SQLite em ./data/erp.db)
# DATABASE_URL=sqlite:///./data/erp.db
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/erp

API_PREFIX=/api/v1
EXCEL_MAX_ROWS=10000
EXCEL_MAX_FILE_MB=20

# Usado pelo frontend (Streamlit) para encontrar a API
ERP_API_URL=http://127.0.0.1:8000/api/v1
